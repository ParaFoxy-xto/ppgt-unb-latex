      \fontsize{14}{16}\selectfont\bfseries \thechapter\quad
    \fi
    \interlinepenalty\@M
    \fontsize{14}{16}\selectfont\bfseries #1\par\nobreak
    \vskip 40\p@
  }}
\def\@makeschapterhead#1{%
  \vspace*{0pt}%
  {\parindent \z@ \centering
    \normalfont
    \interlinepenalty\@M
    \fontsize{14}{16}\selectfont\bfseries  #1\par\nobreak
    \vskip 40\p@
  }}

